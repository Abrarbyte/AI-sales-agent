.env
*.env
!*.env.example

# ─── Backend (Django / Python) ─────────────────────────────
backend/venv/
__pycache__/
*.pyc
backend/db.sqlite3
backend/media/
backend/staticfiles/

# Personal daily work reports — not part of the codebase
backend/reports/

