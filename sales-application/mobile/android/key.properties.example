# Copy to android/key.properties (gitignored) for a store-signed release.
#
# Create the keystore once and keep it safe - losing it means you can never
# update the app on the Play Store:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA #           -keysize 2048 -validity 10000 -alias upload
#
# storeFile is relative to the android/ directory.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
