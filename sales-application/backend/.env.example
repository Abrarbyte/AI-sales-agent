# Copy to .env and fill in. Every value here is read by config/settings.py.
# Nothing in the code needs editing to deploy - only this file.

# --- Required ---------------------------------------------------------------
# 50+ random characters. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Postgres. In docker-compose, DB_HOST is the service name "db".
DB_NAME=sales_tracker
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Deployment -------------------------------------------------------------
# false in production. true prints tracebacks and allows any LAN origin.
DEBUG=false

# The public address: the Tailscale Funnel name of the office PC. The phone
# app has it compiled in (--dart-define=API_BASE=...), so changing it means
# rebuilding and reinstalling the APK.
PUBLIC_URL=https://saleshub.<your-tailnet>.ts.net

# PUBLIC_URL already adds its host to ALLOWED_HOSTS and its origin to
# CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS, and localhost is always
# allowed. List extra addresses here only if the API is also opened another
# way (e.g. the office LAN IP). Hosts: comma-separated, no scheme, no port.
# Origins: full origin with scheme.
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# false under Tailscale Funnel: Funnel terminates https and redirects http
# itself, before a request reaches Django. Set true only behind a proxy that
# does not. (It also marks cookies secure - only the Django admin uses them.)
SECURE_SSL_REDIRECT=false
# Safe to raise once https is known-good (3600, then 31536000). 0 = off.
SECURE_HSTS_SECONDS=0

# Uploads (visit photos, delivery proofs) and collected static files.
# In docker-compose these are volumes; leave as-is.
MEDIA_ROOT=/data/media
STATIC_ROOT=/data/static

# --- Your company, printed on the Payment Receipt PDF ------------------------
# Plain text. Leave a line blank to leave it off the receipt.
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=

# --- Travel allowance --------------------------------------------------------
# How a day's distance is measured. "road" (the default) asks the Google
# Routes API for real driving distance; if Google fails - no key, network
# down, bad reply - that day falls back to straight-line and the claim is
# marked an estimate. "straight" skips Google entirely: haversine between the
# day's points, scaled by the factor below.
TRAVEL_DISTANCE_MODE=road
# Straight-line understates driving; this scales it up. 1.3 is usual for urban.
# Used by "straight" and by the fallback.
TRAVEL_ROAD_FACTOR=1.3
# Needed for "road". A Google Cloud key with the Routes API enabled and
# billing on, restricted to this server's IP. Empty = every day falls back.
GOOGLE_ROUTES_API_KEY=
# Seconds to wait on the Routes API before falling back to straight-line.
GOOGLE_ROUTES_TIMEOUT=10
# The rupees-per-km rate is NOT set here - a Super Admin sets it in the console
# or Django admin (the AllowanceRate table), so it can change without a deploy.

# --- Optional ---------------------------------------------------------------
# Rate limits: login attempts per IP, and requests per signed-in user.
THROTTLE_ANON=20/min
THROTTLE_USER=600/min
# Proxies in front of the API that add the visitor's address: Tailscale
# Funnel and nginx = 2. Set 1 if nginx is reached directly, with no Funnel.
NUM_PROXIES=2
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Reused DB connections, seconds. 0 = a fresh connection per request.
DB_CONN_MAX_AGE=60
# gunicorn workers: 2 x CPU cores + 1 is the usual rule.
WEB_CONCURRENCY=3
# Celery is configured but nothing schedules through it; the run_scheduler
# command covers the jobs without Redis. Set only if you add Celery tasks.
REDIS_URL=
